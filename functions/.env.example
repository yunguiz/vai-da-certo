# Configuração do conector Firebase Data Connect (PostgreSQL)
DATACONNECT_LOCATION="southamerica-east1"
DATACONNECT_SERVICE_ID="street-store-dataconnect"
DATACONNECT_CONNECTOR="default"

# Credenciais do App no Bling (em produção, configure via Firebase Secrets):
#   firebase functions:secrets:set BLING_CLIENT_ID
#   firebase functions:secrets:set BLING_CLIENT_SECRET
BLING_CLIENT_ID="YOUR_BLING_CLIENT_ID"
BLING_CLIENT_SECRET="YOUR_BLING_CLIENT_SECRET"

# Opcional: redirect_uri exata cadastrada no Bling caso deseje fixar explicitamente
BLING_REDIRECT_URI=""
