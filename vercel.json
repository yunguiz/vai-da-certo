{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/bling/keep-alive",
      "schedule": "0 3 * * 1"
    }
  ],
  "rewrites": [
    {
      "source": "/api/((?!bling/callback|bling/keep-alive|bling/sync|bling/sync-produtos|frete/calcular).*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
