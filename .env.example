# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Mercado Pago Payment Integration
MERCADO_PAGO_PUBLIC_KEY="YOUR_MERCADO_PAGO_PUBLIC_KEY"
VITE_MERCADO_PAGO_PUBLIC_KEY="YOUR_MERCADO_PAGO_PUBLIC_KEY"
MERCADO_PAGO_ACCESS_TOKEN="YOUR_MERCADO_PAGO_ACCESS_TOKEN"
MERCADO_PAGO_CLIENT_ID="YOUR_MERCADO_PAGO_CLIENT_ID"
MERCADO_PAGO_CLIENT_SECRET="YOUR_MERCADO_PAGO_CLIENT_SECRET"
# Bling ERP API v3 Integration
BLING_CLIENT_ID="YOUR_BLING_CLIENT_ID"
BLING_CLIENT_SECRET="YOUR_BLING_CLIENT_SECRET"
BLING_REDIRECT_URI="https://seu-projeto.vercel.app/api/bling/callback"
BLING_STATE="YOUR_BLING_STATE"
BLING_AUTHORIZE_URL="https://www.bling.com.br/Api/v3/oauth/authorize"
BLING_ACCESS_TOKEN=""
BLING_REFRESH_TOKEN=""
# Firebase Admin SDK (Vercel Serverless — use JSON/Base64 OR individual credentials below)
FIREBASE_SERVICE_ACCOUNT="YOUR_FIREBASE_SERVICE_ACCOUNT_JSON_OR_BASE64"
FIREBASE_SERVICE_ACCOUNT_KEY=""
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_DATABASE_ID="(default)"
CRON_SECRET="YOUR_VERCEL_CRON_SECRET"
# Melhor Envio API v2 (Token JWT Fixo - sem fluxo de refresh token)
# Produção: https://melhorenvio.com.br | Sandbox: https://sandbox.melhorenvio.com.br
MELHOR_ENVIO_URL="https://melhorenvio.com.br"
MELHOR_ENVIO_TOKEN="YOUR_MELHOR_ENVIO_FIXED_JWT_TOKEN"
MELHOR_ENVIO_USER_AGENT="StreetStore (seu-email@dominio.com)"
MELHOR_ENVIO_FROM_POSTAL_CODE="35900539"
